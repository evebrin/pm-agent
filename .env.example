# ServiceNow PDI (the URL in your browser's address bar, without any path).
SN_INSTANCE=https://devNNNNNN.service-now.com

# Integration user the agents run as. Created by `python setup_integration_user.py`,
# which fills in these two lines itself: Web service access only, platform-hashed password.
SN_USER=pm_agent_svc
SN_PASSWORD=

# PDI admin: used for setup, seeding, reset and metadata reads, plus the documented exception
# of linking closed incidents to problems. The agents' own work runs as SN_USER. Admin needs the snc_basic_auth_api_access role for REST basic auth.
SN_ADMIN_USER=admin
SN_ADMIN_PASSWORD=

# Optional: LLM for RCA/writing. Leave the key blank to use the deterministic fallbacks.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
