# ServiceNow PDI (the URL in your browser's address bar, without any path).
SN_INSTANCE=https://devNNNNNN.service-now.com

# Integration user the agents run as. Created by `python setup_integration_user.py`,
# which fills in these two lines itself: Web service access only, platform-hashed password.
SN_USER=pm_agent_svc
SN_PASSWORD=

# PDI admin: used for setup, seeding, reset and metadata reads, plus the documented exception
# of linking closed incidents to problems. The agents' own work runs as SN_USER. Admin needs the snc_basic_auth_api_access role for REST basic auth.
SN_ADMIN_USER=admin
SN_ADMIN_PASSWORD=

# Optional: the LLM used by the agents. Leave it unconfigured to use the deterministic fallbacks.
# Any provider works; check it with `python llm.py --test`.
#   LLM_PROVIDER=anthropic          LLM_MODEL=claude-sonnet-4-6
#   LLM_PROVIDER=openai             LLM_MODEL=gpt-4.1
#   LLM_PROVIDER=gemini             LLM_MODEL=gemini-2.5-flash
#   LLM_PROVIDER=xai                LLM_MODEL=grok-build-0.1  (Grok Build; other Grok models work too)
#   LLM_PROVIDER=ollama             LLM_MODEL=llama3.1        (local, no key needed)
#   LLM_PROVIDER=openai_compatible  LLM_MODEL=...  LLM_BASE_URL=https://api.groq.com/openai/v1  (Groq, Mistral, OpenRouter, LM Studio, vLLM ...)
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
# Older names, still accepted for the anthropic provider:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
